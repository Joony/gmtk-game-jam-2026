[node name="Computer" type="Node3D" unique_id=1908069019]
script = ExtResource("1_terminal")
; THE NAV PLOT AND NOTHING ELSE. One page, so there is no flip, no automatic choice, and the
; prompt names what is on it. The deck plan has its own screen on the bridge terminal bank (see
; ShipDisplays) — a console that could show either would make "which display am I looking at" a
; question the player has to answer instead of read.
pages = Array[int]([0])
; NO [E] ON THE NAV PLOT. It is four numbers and an arc, all of them legible from across the
; bridge, and leaning in would show the same four numbers a second later. The deck plan keeps its
; prompt because a chart lying flat on a table genuinely has to be stood over.
lean_in = false

