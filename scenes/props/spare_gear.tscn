[ext_resource type="PackedScene" uid="uid://ds7cu2b6qxpen" path="res://3D-Models/CD_Gear_v1.blend" id="2_model"]

; A gear — one of the three spare parts (TODO 21d). Fungible: any of the three fixes any
; part-or-bodge fault, because `RepairPoint.required_part_group` matches on the `spare_parts`
; group and not on a name. Scarcity is what makes "which repairs are worth it" the decision;
; naming a part per fault would turn that into an inventory hunt instead.
;
; Sized from the measured model rather than guessed: CD_Gear_v1 is 2.81 x 0.63 x 2.95
; units, scaled to a 0.30m longest edge, with the mesh dropped so it sits centred on the
; body. A collider that does not match its mesh is what makes props rest inside shelves and get
; flung apart by the solver — see tests/diag_prop_bounds.gd.

[sub_resource type="BoxShape3D" id="BoxShape3D_part"]
size = Vector3(0.286, 0.064, 0.300)

; Layer 2 = pushable props (see scenes/player.tscn). Off layer 1 so the player does not inherit
; this body's velocity while standing on it.
[node name="SpareGear" type="RigidBody3D" groups=["spare_parts"]]
collision_layer = 2
collision_mask = 3
continuous_cd = true
script = ExtResource("1_interactable")
interaction_type = 0
interaction_text = "Pick up gear"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_part")

[node name="Model" parent="." instance=ExtResource("2_model")]
