[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/game/consumable.gd" id="1_consumable"]
[ext_resource type="PackedScene" uid="uid://bcxp08n1qigli" path="res://3D-Models/CD_Battery_v1.blend" id="2_model"]

; A fuel cell for the drive. Carried one at a time from the cargo bay to the engine's tank,
; and slotted in — a Consumable of kind `battery`, so it goes through exactly the same
; Silo.service() path as an air canister does. That is the whole claim of TODO 17a holding up
; on a sixth system: no new script, one prop scene, one row in ShipSupplies.
;
; NOT a BatteryCube. That is the cable puzzle's power source — you plug a cable into it and
; carry electricity to a device. This is fuel: it goes in and it stays in. They look alike and
; do entirely different jobs, which is why they are separate scenes rather than one with a mode.
;
; `becomes` is empty, so a spent cell is consumed. A flat cell you had to carry back would need
; a recharging station the ship does not have.
;
; ART: the ringed battery (charge shown as rings) is still outstanding — see TODO 17f. This
; uses CD_Battery_v1, which is 6.250 x 8.837 x 6.250 units with its origin at the base, scaled
; to a 0.70m cell you can just about get your arms round.

; MEASURED against the model, not assumed: tests/diag_prop_bounds.gd. The comment above dates
; from when CD_PowerCell was 8.837 units tall; it is 2.65 units now, so at the 0.0792 scale
; below the cell you actually see is 0.16 x 0.21 x 0.16 m. The collider was still describing
; the old 0.70m cell — 3.3x the mesh — which is why cells sat interpenetrating shelves and the
; floor and got flung apart by the solver.
[sub_resource type="CylinderShape3D" id="CylinderShape3D_cell"]
radius = 0.08
height = 0.21

; Layer 2 = pushable props (see scenes/player.tscn). Off layer 1 so the player does not inherit
; this body's velocity while standing on it.
[node name="PowerCell" type="RigidBody3D" groups=["consumables"]]
collision_layer = 2
collision_mask = 3
continuous_cd = true
script = ExtResource("1_consumable")
kind = &"battery"
amount = 0.5
interaction_type = 0
interaction_text = "Pick up power cell"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("CylinderShape3D_cell")

; Dropped half its height, because the model's origin is at its base and Carry would otherwise
; hold the cell dangling from underneath. That drop must be half of the REAL height: the model
; is 2.65 units, so at 0.0792 the cell is 0.21m and the drop is 0.105. It was -0.35 — half of
; the 0.70m the cell has not been since CD_PowerCell was re-authored — which parked the mesh a
; quarter-metre below its own collider.
[node name="Model" parent="." instance=ExtResource("2_model")]
transform = Transform3D(0.0792, 0, 0, 0, 0.0792, 0, 0, 0, 0.0792, 0, -0.105, 0)

; CD_Battery_v1 ships a StaticBody3D on its Socket mesh. Inside a RigidBody that is a second
; collider the physics engine drags around, fighting this body's own shape — and it does not
; merely snag: the cells were found sitting TWENTY-ONE METRES above the cargo bay, launched
; through the hull on the first physics frame. Layers cleared so it collides with nothing.
; pickup_crate.tscn hit the same trap with the crate's `-col` mesh.
[node name="StaticBody3D" parent="Model/Socket" index="0"]
collision_layer = 0
collision_mask = 0
