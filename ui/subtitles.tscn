[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/subtitles.gd" id="1_subtitles"]

; Layer 45: above the HUD (35) and the reticle (40), below the pause menu (50). A caption is
; the most important thing on screen while it is up — it is the only channel a player with the
; sound off has — but it must not sit over a menu they are trying to read.
;
; An outlined Label with no panel behind it, matching the rest of the HUD. A solid caption bar
; would be the only opaque box in the game and would black out the middle-bottom of the screen
; for the whole of the eighteen-second intro; a heavy outline stays legible against the white
; of a lit corridor and against space, without hiding either.

[node name="Subtitles" type="CanvasLayer"]
layer = 45
script = ExtResource("1_subtitles")

