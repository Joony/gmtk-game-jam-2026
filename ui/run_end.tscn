[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/run_end.gd" id="1_end"]

; Layer 70: above the pause menu (50) and the start prompt (60). A run that has ended
; must not be dismissable back into a game that no longer exists.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_normal"]
bg_color = Color(0.12, 0.13, 0.16, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.48, 0.55, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_focus"]
bg_color = Color(0.2, 0.22, 0.26, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.85, 0.2, 0.18, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="RunEnd" type="CanvasLayer"]
layer = 70
script = ExtResource("1_end")

; Fully opaque, and faded in from nothing by RunEnd.fade_to_black(). It used to be 86% black
; over a live view; now the run ends by blacking out, so the numbers arrive on black rather
; than over a room the player is no longer in.
[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.24, 0.9, 0.4, 1)
theme_override_font_sizes/font_size = 96
text = "ARRIVED"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.86, 1)
theme_override_font_sizes/font_size = 34
text = ""
horizontal_alignment = 1

; Two columns, not one space-padded label: the game's font is proportional, so padded
; text does not line up and the payoff screen looks slapdash.
[node name="Stats" type="GridContainer" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 40
theme_override_constants/v_separation = 2
columns = 2

; THE SUMMARY SCROLLS. `Choices` was a bare VBoxContainer here, so its height was however many
; lines the run produced — about forty for a full crossing — and it grew this VBox straight past
; the bottom of the viewport, taking the Continue button with it. The button is the only way out
; of the screen, so a long run could not be dismissed.
;
; The cap is a MINIMUM size on the scroller rather than a maximum on the list: a CenterContainer
; sizes to its child's minimum, so anything that leaves the list free to report its own full
; height puts us back where we started. 420px is roughly a dozen lines at font 28, which clears
; a collapsed summary of a typical run without scrolling at all.
[node name="ChoicesScroll" type="ScrollContainer" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 420)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Choices" type="VBoxContainer" parent="Center/VBox/ChoicesScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2
alignment = 1

[node name="Spacer" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="ContinueButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(433, 87)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 37
theme_override_styles/normal = SubResource("StyleBoxFlat_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_focus")
theme_override_styles/focus = SubResource("StyleBoxFlat_focus")
text = "Back to Menu"
